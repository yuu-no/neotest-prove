root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{lua,md,yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[*.{pl,pm,t}]
indent_style = space
indent_size = 4

[*.txt]
# Vim help files use tabs for tag alignment.
indent_style = tab
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
