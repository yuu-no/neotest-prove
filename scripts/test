#!/usr/bin/env bash
# Run the Lua test suite with plenary busted.
# Usage: scripts/test [path/to/single_spec.lua]
set -uo pipefail

tempfile=".test_output.tmp"

if [[ -n "${1:-}" ]]; then
  # Not `PlenaryBustedFile`: it re-spawns nvim with no way to forward a minimal
  # init, so the spec would run without the bootstrapped deps on the
  # runtimepath. Run busted in this instance, which already sourced tests/init.vim.
  spec=$(printf '%s' "$1" | sed "s/[\\\\']/\\\\&/g")
  nvim --headless --noplugin -u tests/init.vim \
    -c "lua require('plenary.busted').run(vim.fn.fnamemodify('${spec}', ':p'))" | tee "${tempfile}"
else
  nvim --headless --noplugin -u tests/init.vim \
    -c "PlenaryBustedDirectory tests/ { minimal_init = 'tests/init.vim' }" | tee "${tempfile}"
fi

# Plenary does not exit non-zero when tests error during setup.
errors=$(sed 's/\x1b\[[0-9;]*m//g' "${tempfile}" | awk '/(Errors|Failed)[[:space:]]+:/ {print $3}' | grep -v '^0$' || true)
rm -f "${tempfile}"

if [[ -n "${errors}" ]]; then
  echo "Tests failed"
  exit 1
fi

exit 0
